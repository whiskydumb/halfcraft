# the repository keeps lf; checkouts get the platform's line endings
* text=auto

# windows scripts stay crlf, unix ones lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
minecraft/gradlew text eol=lf

# applied with git apply onto the sdk: byte for byte
*.patch -text

*.jpg binary
*.png binary
*.jar binary
