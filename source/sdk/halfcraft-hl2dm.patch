@@ -169,6 +169,37 @@ void WriteUsercmd( bf_write *buf, const CUserCmd *to, const CUserCmd *from )
 		buf->WriteOneBit( 0 );
 	}
 
+	// halfcraft
+	if ( to->hc_flags != from->hc_flags )
+	{
+		buf->WriteOneBit( 1 );
+		buf->WriteUBitLong( to->hc_flags, 8 );
+	}
+	else
+	{
+		buf->WriteOneBit( 0 );
+	}
+
+	if ( to->hc_origin != from->hc_origin )
+	{
+		buf->WriteOneBit( 1 );
+		buf->WriteBitVec3Coord( to->hc_origin );
+	}
+	else
+	{
+		buf->WriteOneBit( 0 );
+	}
+
+	if ( to->hc_velocity != from->hc_velocity )
+	{
+		buf->WriteOneBit( 1 );
+		buf->WriteBitVec3Coord( to->hc_velocity );
+	}
+	else
+	{
+		buf->WriteOneBit( 0 );
+	}
+
 #if defined( HL2_CLIENT_DLL )
 	if ( to->entitygroundcontact.Count() != 0 )
 	{
@@ -289,6 +320,22 @@ void ReadUsercmd( bf_read *buf, CUserCmd *move, CUserCmd *from )
 		move->mousedy = buf->ReadShort();
 	}
 
+	// halfcraft
+	if ( buf->ReadOneBit() )
+	{
+		move->hc_flags = buf->ReadUBitLong( 8 );
+	}
+
+	if ( buf->ReadOneBit() )
+	{
+		buf->ReadBitVec3Coord( move->hc_origin );
+	}
+
+	if ( buf->ReadOneBit() )
+	{
+		buf->ReadBitVec3Coord( move->hc_velocity );
+	}
+
 #if defined( HL2_DLL )
 	if ( buf->ReadOneBit() )
 	{
