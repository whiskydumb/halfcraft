+COMPILE_TIME_ASSERT( offsetof( StartSoundParams_t, entchannel ) == 0x0C );
+COMPILE_TIME_ASSERT( offsetof( StartSoundParams_t, pSfx ) == 0x10 );
+COMPILE_TIME_ASSERT( offsetof( StartSoundParams_t, flags ) == 0x38 );
+COMPILE_TIME_ASSERT( offsetof( StartSoundParams_t, fromserver ) == 0x44 );
