//-----------------------------------------------------------------------------
//	HALFCRAFT_SERVER.VPC
//
//	halfcraft's code in server.dll. included from game\server\server_hl2.vpc of
//	both sdk trees (source\sdk\halfcraft-<engine>.patch), which set
//	$HALFCRAFTROOT to the repo: the trees sit at different depths below it.
//-----------------------------------------------------------------------------

$Macro HALFCRAFTDIR		"$HALFCRAFTROOT\source"
$Macro HALFCRAFTPROTO	"$HALFCRAFTROOT\protocol"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;$HALFCRAFTDIR\src;$HALFCRAFTPROTO"
		$AdditionalOptions				"$BASE /std:c++17"
	}
}

$Project
{
	$Folder	"Source Files"
	{
		$Folder	"HalfCraft"
		{
			$File	"$HALFCRAFTDIR\src\shared\hc_hooks.h"
			$File	"$HALFCRAFTDIR\src\shared\hc_movement.cpp"
			$File	"$HALFCRAFTDIR\src\shared\hc_floors.h"
			$File	"$HALFCRAFTDIR\src\shared\hc_floors.cpp"
			$File	"$HALFCRAFTDIR\src\shared\hc_bridge.h"
			$File	"$HALFCRAFTDIR\src\shared\hc_weapon_ids.h"
			$File	"$HALFCRAFTDIR\src\server\hc_blast.h"
			$File	"$HALFCRAFTDIR\src\server\hc_blast.cpp"
			$File	"$HALFCRAFTDIR\src\server\hc_block_solids.h"
			$File	"$HALFCRAFTDIR\src\server\hc_block_solids.cpp"
			$File	"$HALFCRAFTDIR\src\server\hc_campaign.cpp"
			$File	"$HALFCRAFTDIR\src\server\hc_lost_coast.cpp"
			$File	"$HALFCRAFTDIR\src\server\hc_checkpoints.h"
			$File	"$HALFCRAFTDIR\src\server\hc_checkpoints.cpp"
			$File	"$HALFCRAFTDIR\src\server\hc_combat.h"
			$File	"$HALFCRAFTDIR\src\server\hc_combat.cpp"
			$File	"$HALFCRAFTDIR\src\server\hc_debug_target.h"
			$File	"$HALFCRAFTDIR\src\server\hc_debug_target.cpp"
			$File	"$HALFCRAFTDIR\src\server\hc_hazards.h"
			$File	"$HALFCRAFTDIR\src\server\hc_hazards.cpp"
			$File	"$HALFCRAFTDIR\src\server\hc_mobs.h"
			$File	"$HALFCRAFTDIR\src\server\hc_mobs.cpp"
			$File	"$HALFCRAFTDIR\src\server\hc_push.h"
			$File	"$HALFCRAFTDIR\src\server\hc_push.cpp"
			$File	"$HALFCRAFTDIR\src\server\hc_server.cpp"
			$File	"$HALFCRAFTDIR\src\server\hc_vitals.h"
			$File	"$HALFCRAFTDIR\src\server\hc_vitals.cpp"
			$File	"$HALFCRAFTDIR\src\server\hc_weapons.h"
			$File	"$HALFCRAFTDIR\src\server\hc_weapons.cpp"
			$File	"$HALFCRAFTDIR\src\server\hc_world_collision.h"
			$File	"$HALFCRAFTDIR\src\server\hc_world_collision.cpp"

			$Folder	"Core"
			{
				$File	"$HALFCRAFTPROTO\halfcraft_protocol.h"
				$File	"$HALFCRAFTDIR\src\core\hc_atomic.h"
				$File	"$HALFCRAFTDIR\src\core\hc_campaign.h"
				$File	"$HALFCRAFTDIR\src\core\hc_collision.h"
				$File	"$HALFCRAFTDIR\src\core\hc_collision_shapes.h"
				$File	"$HALFCRAFTDIR\src\core\hc_grid.h"
				$File	"$HALFCRAFTDIR\src\core\hc_link.h"
				$File	"$HALFCRAFTDIR\src\core\hc_log.h"
				$File	"$HALFCRAFTDIR\src\core\hc_module.h"
				$File	"$HALFCRAFTDIR\src\core\hc_text.h"
				$File	"$HALFCRAFTDIR\src\core\hc_units.h"
				$File	"$HALFCRAFTDIR\src\core\hc_collision.cpp" \
						"$HALFCRAFTDIR\src\core\hc_link.cpp" \
						"$HALFCRAFTDIR\src\core\hc_log.cpp" \
						"$HALFCRAFTDIR\src\core\hc_module.cpp" \
						"$HALFCRAFTDIR\src\core\hc_units.cpp"
				{
					$Configuration
					{
						$Compiler
						{
							$Create/UsePrecompiledHeader	"Not Using Precompiled Headers"
						}
					}
				}
			}
		}
	}
}
