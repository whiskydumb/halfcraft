// HalfCraft.exe's resources. version.h comes from tools/halfcraft/build.py (halfcraft's version, from
// git's tags: tools/halfcraft/version.py).

#include <windows.h>
#include "version.h"

1 ICON "halfcraft.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "halfcraft.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION HC_VERSION
PRODUCTVERSION HC_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "HalfCraft"
			VALUE "FileDescription", "HalfCraft"
			VALUE "FileVersion", HC_VERSION_TEXT
			VALUE "InternalName", "HalfCraft"
			VALUE "LegalCopyright", "MIT License"
			VALUE "OriginalFilename", "HalfCraft.exe"
			VALUE "ProductName", "HalfCraft"
			VALUE "ProductVersion", HC_VERSION_TEXT
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
